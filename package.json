{
  "name": "dranzo-payments",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant client subscription, billing, reminder & compliance management platform.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "migration:run": "npm --workspace apps/api run migration:run",
    "migration:generate": "npm --workspace apps/api run migration:generate",
    "seed": "npm --workspace apps/api run seed",
    "lint": "npm --workspaces --if-present run lint",
    "test": "npm --workspaces --if-present run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
