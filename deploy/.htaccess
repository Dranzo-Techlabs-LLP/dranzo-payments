# =====================================================================
# Dranzo Payments — Apache config (cPanel / WHM)
# Place at: /home/deskhubdranzo/public_html/.htaccess
# Assumes:
#   - PM2 runs the API at http://127.0.0.1:4010
#   - mod_proxy + mod_proxy_http are enabled (default on WHM)
#   - Built web assets live in /home/deskhubdranzo/public_html
# =====================================================================

# ---- Force HTTPS (cPanel AutoSSL handles the cert) ----
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Reverse-proxy /api/* to the Node app on 127.0.0.1:4010 ----
# IMPORTANT: this must come BEFORE the SPA fallback so /api requests
# don't get rewritten to index.html.
RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
RewriteRule ^api(/.*)?$ http://127.0.0.1:4010/api$1 [P,L]

# Allow Apache to forward headers (Authorization is dropped by default)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
ProxyPassReverse /api http://127.0.0.1:4010/api

# ---- SPA fallback: anything else hits index.html so React Router works ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api(/|$)
RewriteRule ^ index.html [L]

# ---- Long-cache static assets, short-cache index.html ----
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Compress text assets ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>

# ---- Block dotfiles ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>
