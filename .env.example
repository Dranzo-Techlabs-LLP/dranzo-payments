# ============================================================
# Dranzo Payments — environment template
# Copy to .env (never commit). Real DB creds live in .env only.
# ============================================================

NODE_ENV=development

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=dp
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_TTL=30d

# Bcrypt
BCRYPT_ROUNDS=12

# Mail (Slice 6+)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dranzo Payments <no-reply@dranzo.local>"

# Storage (logo uploads — placeholder for Slice 1)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
